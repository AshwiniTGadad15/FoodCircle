# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Admin Dashboard sign-in.
# If left empty, the first user can claim Admin access via the inline setup screen.
ADMIN_PASSCODE=

# GOOGLE_CLIENT_ID: Optional Google OAuth client ID if configuring Google Sign-In.
GOOGLE_CLIENT_ID=
